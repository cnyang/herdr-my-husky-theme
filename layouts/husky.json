{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.11"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "husky-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "husky-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "husky-agents"
              },
              "size": {
                "weight": 2
              },
              "min": 180
            }
          ],
          "divider": {
            "width": 2,
            "color": "accent"
          }
        },
        {
          "id": "music",
          "type": "block",
          "content": {
            "mod": "husky-music"
          },
          "size": {
            "px": 0
          },
          "min": 0
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "husky-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 190
      },
      "min": 44,
      "max": 480,
      "background": {
        "image": "mods/husky-chrome/sidebar-v4.png",
        "fit": "cover"
      },
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "husky-tabs"
          },
          "size": {
            "px": 48
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": {
                    "image": "mods/husky-chrome/terminal-background-v4.png",
                    "fit": "cover"
                  },
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 8,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "file-icons",
                        "props": {
                          "alpha": "00"
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "husky-changes"
                      }
                    },
                    {
                      "id": "graph",
                      "type": "block",
                      "content": {
                        "mod": "husky-git-graph"
                      }
                    },
                    {
                      "id": "lyrics",
                      "type": "block",
                      "content": {
                        "mod": "husky-lyrics"
                      }
                    },
                    {
                      "id": "notes",
                      "type": "block",
                      "content": {
                        "mod": "husky-notes"
                      }
                    },
                    {
                      "id": "calendar",
                      "type": "block",
                      "content": {
                        "mod": "husky-calendar"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "background": {
                "image": "mods/husky-chrome/sidebar-v4.png",
                "fit": "cover"
              },
              "radius": 8
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": "husky",
  "terminal_opacity": 0.6,
  "preview": "layouts/husky.svg"
}
